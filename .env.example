# Copy to .env in this same folder: cloudie/cloudie-backend/.env
MONGO_URI=
PORT=8000

CLOUDINARY_Cloud=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

STRIPE_SECRET_KEY=

# --- Email (OTP / forgot password) ---
#
# LOCAL (Mac): Gmail SMTP usually works:
#   NODE_MAILER_HOST=smtp.gmail.com
#   NODE_MAILER_PORT=465
#   NODE_MAILER_SECURE=true
#   NODE_MAILER_USER=your@gmail.com
#   NODE_MAILER_PASS=google-app-password
#
# RAILWAY / production: Gmail SMTP often ETIMEDOUT — use ONE of:
#
# A) SendGrid SMTP (recommended, same nodemailer code):
#   NODE_MAILER_HOST=smtp.sendgrid.net
#   NODE_MAILER_PORT=587
#   NODE_MAILER_SECURE=false
#   NODE_MAILER_USER=apikey
#   NODE_MAILER_PASS=SG.your_sendgrid_api_key
#   MAIL_FROM=verified-sender@yourdomain.com
#
# B) Resend HTTPS API (works on Railway):
#   RESEND_API_KEY=re_xxxx
#   EMAIL_FROM=support@yourverifieddomain.com
#   EMAIL_FROM_NAME=Cloudie

NODE_MAILER_USER=
NODE_MAILER_PASS=
NODE_MAILER_HOST=smtp.gmail.com
NODE_MAILER_PORT=587
NODE_MAILER_SECURE=false
MAIL_FROM=

RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=
